## Framework Envs ##
APP_NAME="CCADB Monitor"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=${APP_URL}

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

DB_CONNECTION=${DB_CONNECTION}
DB_DATABASE=${DB_DATABASE}
DB_HOST=${DB_HOST}
DB_PORT=${DB_PORT}
DB_USERNAME=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=${LOG_STACK}
LOGGING_EMAIL_RECIPIENTS=${LOGGING_EMAIL_RECIPIENTS}
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=${LOG_LEVEL}

LOG_SLACK_WEBHOOK_URL=${LOG_SLACK_WEBHOOK_URL}
LOG_TEAMS_WEBHOOK_URL=${LOG_TEAMS_WEBHOOK_URL}

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

CACHE_STORE=file
CACHE_PREFIX=laravel_cache

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=${MAIL_HOST}
MAIL_PORT=${MAIL_PORT}
MAIL_USERNAME=${MAIL_USERNAME}
MAIL_PASSWORD=${MAIL_PASSWORD}
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

## Application Envs ##
CCADB_ALL_CERTIFICATE_RECORDS_URL=https://ccadb.my.salesforce-sites.com/ccadb/AllCertificateRecordsCSVFormatV4a
HTTP_USER_AGENT=CCADBMonitor/1.0
CA_OWNER="${CA_OWNER}"
CRL_MAX_SIGNATURE_AGE_HOURS=24
ROOT_CA_CRL_MAX_SIGNATURE_AGE_HOURS=720
ROOT_CA_CRL_MAX_SIGNATURE_AGE_CNS="CN=Example Root CA, CN=Another Root CA"
